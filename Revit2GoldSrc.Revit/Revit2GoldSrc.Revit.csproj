<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
<TargetFramework Condition="'$(RevitVersion)' == '2024'">net48</TargetFramework>
<TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
<TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
<UseWPF>true</UseWPF><PlatformTarget>x64</PlatformTarget>
<RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
<OutputPath>bin/$(RevitVersion)/$(Configuration)/</OutputPath>
<DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
</PropertyGroup>
<ItemGroup>
<Reference Include="RevitAPI"><HintPath>$(RevitInstallDir)/RevitAPI.dll</HintPath><Private>false</Private></Reference>
<Reference Include="RevitAPIUI"><HintPath>$(RevitInstallDir)/RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
<ProjectReference Include="../Revit2GoldSrc.GoldSrc/Revit2GoldSrc.GoldSrc.csproj" />
</ItemGroup>
<Target Name="ValidateRevitApi" BeforeTargets="ResolveAssemblyReferences">
<Error Condition="'$(RevitVersion)' != '2024' And '$(RevitVersion)' != '2025' And '$(RevitVersion)' != '2026' And '$(RevitVersion)' != '2027'" Text="RevitVersion debe ser 2024, 2025, 2026 o 2027." />
<Error Condition="!Exists('$(RevitInstallDir)/RevitAPI.dll') Or !Exists('$(RevitInstallDir)/RevitAPIUI.dll')" Text="Faltan DLL de Revit $(RevitVersion) en $(RevitInstallDir). Configure RevitInstallDir; no se utilizan DLL de otro año." />
<GetAssemblyIdentity AssemblyFiles="$(RevitInstallDir)/RevitAPI.dll;$(RevitInstallDir)/RevitAPIUI.dll"><Output TaskParameter="Assemblies" ItemName="RevitApiIdentity" /></GetAssemblyIdentity>
<PropertyGroup><ExpectedApiPrefix>$([MSBuild]::Subtract($(RevitVersion), 2000)).</ExpectedApiPrefix></PropertyGroup>
<Error Condition="!$([System.String]::Copy('%(RevitApiIdentity.Version)').StartsWith('$(ExpectedApiPrefix)'))" Text="La DLL %(RevitApiIdentity.Name) %(RevitApiIdentity.Version) no corresponde a Revit $(RevitVersion)." />
</Target><ItemGroup><ProjectReference Include="../Revit2GoldSrc.Compilation/Revit2GoldSrc.Compilation.csproj" /></ItemGroup><ItemGroup><ProjectReference Include="../Revit2Source.Compilation/Revit2Source.Compilation.csproj" /></ItemGroup></Project>
